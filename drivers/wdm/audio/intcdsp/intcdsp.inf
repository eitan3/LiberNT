; PROJECT:     LiberNT Intel Smart Sound DSP driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Intel audio DSP driver installation file: the driver of the hdaudbus CSAUDIO\ADSP child, probe-only unless the BootDsp value is set
; COPYRIGHT:   Copyright 2026 LiberNT contributors

[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=11/24/2026,1.0.0.0
PnPLockdown=1

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=IntcDspMfg,NTx86,NTamd64

; Arrow Lake-S/HX (7F50) and Meteor Lake (7E28): the two controllers this driver boots, each with its own firmware (sof-arl-s.ri, sof-mtl.ri; the ACE 1.0 register map they share) when BootDsp is set; the others are probe-only, their DSPs are not touched
[IntcDspMfg.NTx86]
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7F50
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7E28
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7728
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_A828
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_E328
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_E428

[IntcDspMfg.NTamd64]
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7F50
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7E28
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_7728
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_A828
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_E328
%IntcDsp.DeviceDesc%=IntcDsp_Inst,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_E428

[IntcDsp_Inst.NT]
CopyFiles=IntcDsp_CopyFiles.NT

[IntcDsp_CopyFiles.NT]
intcdsp.sys

[IntcDsp_Inst.NT.Services]
AddService=intcdsp,0x00000002,IntcDsp_Service_Inst

; BootDsp (REG_DWORD) under the service's Settings key: 0, the default, only logs the controller's facts; 1 boots the DSP at the next D0 entry, from the firmware file the controller's platform record names (sof-arl-s.ri or sof-mtl.ri, shipped beside LICENCE.Intel)
; SelfTest: 1 runs the IPC self-test after a boot, 2 the loopback self-test (a render and a capture stream of the topology's PCM 'Loopback', 16, 24 and 32 bits); UseInterrupts: 1 lets the IPC transport use the DSP's interrupt line; IpcTimeoutMs: the budget of every IPC message in milliseconds
; Topology (REG_SZ): the topology file the booted DSP runs, a plain file name under System32\drivers\intel\sof-tplg (sof-ipc4-loopback.tplg ships there); absent, the DMI quirk table and the controller's _DSD names decide, and with neither the DSP is powered down again
[IntcDsp_Service_Inst]
DisplayName=%IntcDsp.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\intcdsp.sys
AddReg=IntcDsp_Service_AddReg

[IntcDsp_Service_AddReg]
HKR,Settings,BootDsp,0x00010001,0
HKR,Settings,SelfTest,0x00010001,0
HKR,Settings,UseInterrupts,0x00010001,0
HKR,Settings,IpcTimeoutMs,0x00010001,500

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
intcdsp.sys=1

[Strings]
ProviderName="LiberNT"
ManufacturerName="Intel"
DiskName="LiberNT Installation Media"
IntcDsp.DeviceDesc="Intel Smart Sound Technology DSP"
IntcDsp.ServiceDesc="Intel Smart Sound DSP driver"
