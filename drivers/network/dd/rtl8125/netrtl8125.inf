; PROJECT:     LiberNT Realtek RTL8125/RTL8126 Ethernet Driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Installation file for RTL8125 (2.5 GbE) and RTL8126 (5 GbE) controllers
; COPYRIGHT:   Copyright 2026 The LiberNT contributors

[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %LiberNT%
DriverVer  = 11/28/2026,1.00

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%RealtekMfg% = RealtekMfg,NTamd64,NTarm64

[RealtekMfg.NTamd64]
%RTL8125.DeviceDesc% = RTL8125_Inst.ndi,PCI\VEN_10EC&DEV_8125
%RTL8126.DeviceDesc% = RTL8125_Inst.ndi,PCI\VEN_10EC&DEV_8126

[RealtekMfg.NTarm64]
%RTL8125.DeviceDesc% = RTL8125_Inst.ndi,PCI\VEN_10EC&DEV_8125
%RTL8126.DeviceDesc% = RTL8125_Inst.ndi,PCI\VEN_10EC&DEV_8126

[RTL8125_Inst.ndi.NT]
Characteristics    = 0x4 ; NCF_PHYSICAL
BusType            = 5   ; PCIBus
*IfType            = 6
*MediaType         = 0
*PhysicalMediaType = 14
AddReg             = RTL8125_AddReg.NT, RTL8125_Params.NT
CopyFiles          = RTL8125_CopyFiles.NT

[RTL8125_Inst.ndi.NT.HW]
AddReg = RTL8125_HwAddReg.NT

[RTL8125_CopyFiles.NT]
rtl8125.sys

[RTL8125_AddReg.NT]
HKR, Ndi,            Service,    0, "rtl8125"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[RTL8125_Params.NT]
HKR, Ndi\Params\NetworkAddress, ParamDesc, 0, %NetworkAddress%
HKR, Ndi\Params\NetworkAddress, Type,      0, "edit"
HKR, Ndi\Params\NetworkAddress, LimitText, 0, "12"
HKR, Ndi\Params\NetworkAddress, UpperCase, 0, "1"
HKR, Ndi\Params\NetworkAddress, Optional,  0, "1"
HKR, Ndi\Params\NetworkAddress, Default,   0, ""

HKR, Ndi\Params\*IPChecksumOffloadIPv4,       ParamDesc, 0, %IPChksumV4%
HKR, Ndi\Params\*IPChecksumOffloadIPv4,       Type,      0, "enum"
HKR, Ndi\Params\*IPChecksumOffloadIPv4,       Default,   0, "3"
HKR, Ndi\Params\*IPChecksumOffloadIPv4\enum,  "0",       0, %Disabled%
HKR, Ndi\Params\*IPChecksumOffloadIPv4\enum,  "1",       0, %TxEnabled%
HKR, Ndi\Params\*IPChecksumOffloadIPv4\enum,  "2",       0, %RxEnabled%
HKR, Ndi\Params\*IPChecksumOffloadIPv4\enum,  "3",       0, %RxTxEnabled%

HKR, Ndi\Params\*TCPChecksumOffloadIPv4,       ParamDesc, 0, %TcpChksumV4%
HKR, Ndi\Params\*TCPChecksumOffloadIPv4,       Type,      0, "enum"
HKR, Ndi\Params\*TCPChecksumOffloadIPv4,       Default,   0, "3"
HKR, Ndi\Params\*TCPChecksumOffloadIPv4\enum,  "0",       0, %Disabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv4\enum,  "1",       0, %TxEnabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv4\enum,  "2",       0, %RxEnabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv4\enum,  "3",       0, %RxTxEnabled%

HKR, Ndi\Params\*UDPChecksumOffloadIPv4,       ParamDesc, 0, %UdpChksumV4%
HKR, Ndi\Params\*UDPChecksumOffloadIPv4,       Type,      0, "enum"
HKR, Ndi\Params\*UDPChecksumOffloadIPv4,       Default,   0, "3"
HKR, Ndi\Params\*UDPChecksumOffloadIPv4\enum,  "0",       0, %Disabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv4\enum,  "1",       0, %TxEnabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv4\enum,  "2",       0, %RxEnabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv4\enum,  "3",       0, %RxTxEnabled%

HKR, Ndi\Params\*TCPChecksumOffloadIPv6,       ParamDesc, 0, %TcpChksumV6%
HKR, Ndi\Params\*TCPChecksumOffloadIPv6,       Type,      0, "enum"
HKR, Ndi\Params\*TCPChecksumOffloadIPv6,       Default,   0, "3"
HKR, Ndi\Params\*TCPChecksumOffloadIPv6\enum,  "0",       0, %Disabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv6\enum,  "1",       0, %TxEnabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv6\enum,  "2",       0, %RxEnabled%
HKR, Ndi\Params\*TCPChecksumOffloadIPv6\enum,  "3",       0, %RxTxEnabled%

HKR, Ndi\Params\*UDPChecksumOffloadIPv6,       ParamDesc, 0, %UdpChksumV6%
HKR, Ndi\Params\*UDPChecksumOffloadIPv6,       Type,      0, "enum"
HKR, Ndi\Params\*UDPChecksumOffloadIPv6,       Default,   0, "3"
HKR, Ndi\Params\*UDPChecksumOffloadIPv6\enum,  "0",       0, %Disabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv6\enum,  "1",       0, %TxEnabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv6\enum,  "2",       0, %RxEnabled%
HKR, Ndi\Params\*UDPChecksumOffloadIPv6\enum,  "3",       0, %RxTxEnabled%

HKR, Ndi\Params\*JumboPacket,       ParamDesc, 0, %JumboPacket%
HKR, Ndi\Params\*JumboPacket,       Type,      0, "enum"
HKR, Ndi\Params\*JumboPacket,       Default,   0, "1514"
HKR, Ndi\Params\*JumboPacket\enum,  "1514",   0, %Disabled%
HKR, Ndi\Params\*JumboPacket\enum,  "4088",   0, %Jumbo4K%
HKR, Ndi\Params\*JumboPacket\enum,  "9014",   0, %Jumbo9K%

HKR, Ndi\Params\*SpeedDuplex,       ParamDesc, 0, %SpeedDuplex%
HKR, Ndi\Params\*SpeedDuplex,       Type,      0, "enum"
HKR, Ndi\Params\*SpeedDuplex,       Default,   0, "0"
HKR, Ndi\Params\*SpeedDuplex\enum,  "0",      0, %AutoNegotiation%
HKR, Ndi\Params\*SpeedDuplex\enum,  "1",      0, %Speed10Half%
HKR, Ndi\Params\*SpeedDuplex\enum,  "2",      0, %Speed10Full%
HKR, Ndi\Params\*SpeedDuplex\enum,  "3",      0, %Speed100Half%
HKR, Ndi\Params\*SpeedDuplex\enum,  "4",      0, %Speed100Full%
HKR, Ndi\Params\*SpeedDuplex\enum,  "6",      0, %Speed1000Full%
HKR, Ndi\Params\*SpeedDuplex\enum,  "2500",   0, %Speed2500Full%
HKR, Ndi\Params\*SpeedDuplex\enum,  "5000",   0, %Speed5000Full%

HKR, Ndi\Params\*FlowControl,       ParamDesc, 0, %FlowControl%
HKR, Ndi\Params\*FlowControl,       Type,      0, "enum"
HKR, Ndi\Params\*FlowControl,       Default,   0, "3"
HKR, Ndi\Params\*FlowControl\enum,  "0",      0, %Disabled%
HKR, Ndi\Params\*FlowControl\enum,  "1",      0, %TxEnabled%
HKR, Ndi\Params\*FlowControl\enum,  "2",      0, %RxEnabled%
HKR, Ndi\Params\*FlowControl\enum,  "3",      0, %RxTxEnabled%

HKR, Ndi\Params\*EEE,       ParamDesc, 0, %Eee%
HKR, Ndi\Params\*EEE,       Type,      0, "enum"
HKR, Ndi\Params\*EEE,       Default,   0, "0"
HKR, Ndi\Params\*EEE\enum,  "0",      0, %Disabled%
HKR, Ndi\Params\*EEE\enum,  "1",      0, %Enabled%

[RTL8125_HwAddReg.NT]
HKR, Interrupt Management,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,MSISupported,0x00010001,1
HKR, Interrupt Management\MessageSignaledInterruptProperties,MessageNumberLimit,0x00010001,1

[RTL8125_Inst.ndi.NT.Services]
AddService = rtl8125, 0x00000002, RTL8125_Service_Inst

[RTL8125_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\rtl8125.sys
LoadOrderGroup = NDIS

[Strings]
; Non-localizable
LiberNT    = "LiberNT Project"
RealtekMfg = "Realtek"

; Localizable
RTL8125.DeviceDesc = "Realtek RTL8125 2.5GbE Ethernet Controller"
RTL8126.DeviceDesc = "Realtek RTL8126 5GbE Ethernet Controller"
NetworkAddress     = "Network Address"
IPChksumV4         = "IPv4 Checksum Offload"
TcpChksumV4        = "TCP Checksum Offload (IPv4)"
UdpChksumV4        = "UDP Checksum Offload (IPv4)"
TcpChksumV6        = "TCP Checksum Offload (IPv6)"
UdpChksumV6        = "UDP Checksum Offload (IPv6)"
Disabled           = "Disabled"
TxEnabled          = "Tx Enabled"
RxEnabled          = "Rx Enabled"
RxTxEnabled        = "Rx & Tx Enabled"
JumboPacket        = "Jumbo Packet"
Jumbo4K            = "4088 Bytes"
Jumbo9K            = "9014 Bytes"
SpeedDuplex        = "Speed & Duplex"
AutoNegotiation    = "Auto Negotiation"
Speed10Half        = "10 Mbps Half Duplex"
Speed10Full        = "10 Mbps Full Duplex"
Speed100Half       = "100 Mbps Half Duplex"
Speed100Full       = "100 Mbps Full Duplex"
Speed1000Full      = "1.0 Gbps Full Duplex"
Speed2500Full      = "2.5 Gbps Full Duplex"
Speed5000Full      = "5 Gbps Full Duplex"
FlowControl        = "Flow Control"
Eee                = "Energy-Efficient Ethernet"
Enabled            = "Enabled"
